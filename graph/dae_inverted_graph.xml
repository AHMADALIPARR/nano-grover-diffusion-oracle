  Refined Inverted DAE Graph  v1.1
  --------------------------------
  Hierarchical tree inversion of SPARK contracts
      {Pre(S)}  Cmd  {Post(S, S')}
  into a continuous-time Differential-Algebraic Equation system.

  Layer order (top → bottom):
    1. Parameters          — constants & physical bounds
    2. Rails               — supply clamps (Bounded Integer image)
    3. Contracts           — SPARK Pre/Cmd/Post anchors
    4. StateVariables      — differential unknowns V(t)
    5. AlgebraicVariables  — constraint unknowns (mean, currents)
    6. Dynamics            — ddt / idt / KCL / KVL / map / clamp edges
    7. CrossDomain         — SPARK ↔ Verilog-A ↔ Transistor table
    8. SemiconductorBounds — device-physics ceilings
-->

<DAEInvertedGraph
    xmlns="urn:sovereign:nano-grover:dae-graph:1.1"
    name="NanoGrover_Braid_DAE"
    version="1.1"
    inversionPrinciple="SPARK_PrePost_to_Continuous_Attractors"
    N="4"
    targetIndex="3">

  <!-- ================================================================ -->
  <!-- 1. Parameters                                                    -->
  <!-- ================================================================ -->
  <Parameters>
    <Param id="V0_scale"   type="real" unit="V"     value="1.0"/>
    <Param id="Cnode"      type="real" unit="F"     value="1.0e-12"/>
    <Param id="Lnode"      type="real" unit="H"     value="1.0e-9"/>
    <Param id="Rndr"       type="real" unit="Ohm"   value="1.0e3"/>
    <Param id="Gm"         type="real" unit="S"     value="1.0e-3"/>
    <Param id="eps"        type="real" unit="1"     value="1.0e-6"/>
    <Param id="omega0"     type="real" unit="rad/s" value="1.0e9"/>
    <Param id="Delta_t"    type="real" unit="s"     value="1.57079632679e-9"/>
    <Param id="PHI_HALF"   type="real" unit="1"     value="0.8090169943749474"/>
    <Param id="V_T"        type="real" unit="mV"    value="25.85"/>
    <Param id="VDD_nom"    type="real" unit="V"     value="1.8"/>
    <Param id="VSS_nom"    type="real" unit="V"     value="0.0"/>
  </Parameters>

  <!-- ================================================================ -->
  <!-- 2. Rails  (SPARK Bounded Integer → physical supply clamps)       -->
  <!-- ================================================================ -->
  <Rails>
    <Rail id="RAIL_VDD"
          polarity="positive"
          valueRef="VDD_nom"
          mapsFrom="Voltage_Rail'Last"
          role="upper_clamp"/>
    <Rail id="RAIL_VSS"
          polarity="negative"
          valueRef="VSS_nom"
          mapsFrom="Voltage_Rail'First"
          role="lower_clamp"/>
  </Rails>

  <!-- ================================================================ -->
  <!-- 3. Contracts  (SPARK Pre / Cmd / Post anchors)                   -->
  <!-- ================================================================ -->
  <Contracts>

    <Contract id="CTRCT_Oracle" procedure="Grover_Oracle_Flip">
      <Pre>
        <Predicate>for all I in Amplitude_Index => V(I) in Voltage_Rail</Predicate>
      </Pre>
      <Cmd>sign-flip of target coordinate (phase inversion)</Cmd>
      <Post>
        <Predicate>V(Target) = -V'Old(Target)</Predicate>
        <Predicate>for all I /= Target => V(I) = V'Old(I)</Predicate>
        <Predicate>for all I => V(I) in Voltage_Rail</Predicate>
      </Post>
      <Inversion>
        <PreMapsTo>InitialCharge on target branch</PreMapsTo>
        <PostMapsTo>Attractor after NDR interval</PostMapsTo>
        <AssertFailMapsTo>RAIL_VDD / RAIL_VSS clamp</AssertFailMapsTo>
      </Inversion>
    </Contract>

    <Contract id="CTRCT_Diffusion" procedure="Grover_Diffusion">
      <Pre>
        <Predicate>for all I in Amplitude_Index => V(I) in Voltage_Rail</Predicate>
      </Pre>
      <Cmd>V ← 2·Vbar − V   (inversion about the mean)</Cmd>
      <Post>
        <Predicate>for all I => V(I) in Voltage_Rail</Predicate>
        <Predicate>nodal balance  dV/dt → 0 on Poincaré section</Predicate>
      </Post>
      <Inversion>
        <PreMapsTo>State entering diffusion window</PreMapsTo>
        <PostMapsTo>Steady-state attractor after mean reflection</PostMapsTo>
        <AssertFailMapsTo>RAIL_VDD / RAIL_VSS clamp</AssertFailMapsTo>
      </Inversion>
    </Contract>

    <Contract id="CTRCT_Braid" procedure="Braid_Matrix_Multiply">
      <Pre>
        <Predicate>Theta in -π .. π</Predicate>
      </Pre>
      <Cmd>φ-weighted linear combination of sin(θ), cos(θ)</Cmd>
      <Post>
        <Predicate>Sin_O in Voltage_Rail</Predicate>
        <Predicate>Cos_O in Voltage_Rail</Predicate>
      </Post>
      <Inversion>
        <PreMapsTo>Bounded angle domain on Theta</PreMapsTo>
        <PostMapsTo>Clamped Sin_O / Cos_O rails</PostMapsTo>
        <AssertFailMapsTo>RAIL_VDD / RAIL_VSS clamp</AssertFailMapsTo>
      </Inversion>
    </Contract>

    <Contract id="CTRCT_Chord" procedure="Chord_Lookup">
      <Pre>
        <Predicate>Sel in Chord_Id (0 .. 2)</Predicate>
      </Pre>
      <Cmd>case Sel → frequency word</Cmd>
      <Post>
        <Predicate>Valid = True ∧ Freq in {Root, Third, Fifth}</Predicate>
      </Post>
      <Inversion>
        <PreMapsTo>Discrete select lines</PreMapsTo>
        <PostMapsTo>Static eigenvalue ROM word</PostMapsTo>
      </Inversion>
    </Contract>

  </Contracts>

  <!-- ================================================================ -->
  <!-- 4. State variables  (differential unknowns)                      -->
  <!-- ================================================================ -->
  <StateVariables>

    <Group id="BasisAmplitudes" dimension="4" basis="computational">

      <State id="V0" domain="voltage" unit="V" index="0" ket="|00⟩">
        <InitialCharge mapsFromContract="CTRCT_Oracle" role="Pre">0.5</InitialCharge>
        <Attractor     mapsFromContract="CTRCT_Diffusion" role="Post">
          steady-state after diffusion
        </Attractor>
        <Bound minRef="RAIL_VSS" maxRef="RAIL_VDD"/>
      </State>

      <State id="V1" domain="voltage" unit="V" index="1" ket="|01⟩">
        <InitialCharge mapsFromContract="CTRCT_Oracle" role="Pre">0.5</InitialCharge>
        <Attractor     mapsFromContract="CTRCT_Diffusion" role="Post">
          steady-state after diffusion
        </Attractor>
        <Bound minRef="RAIL_VSS" maxRef="RAIL_VDD"/>
      </State>

      <State id="V2" domain="voltage" unit="V" index="2" ket="|10⟩">
        <InitialCharge mapsFromContract="CTRCT_Oracle" role="Pre">0.5</InitialCharge>
        <Attractor     mapsFromContract="CTRCT_Diffusion" role="Post">
          steady-state after diffusion
        </Attractor>
        <Bound minRef="RAIL_VSS" maxRef="RAIL_VDD"/>
      </State>

      <State id="V3" domain="voltage" unit="V" index="3" ket="|11⟩" isTarget="true">
        <InitialCharge mapsFromContract="CTRCT_Oracle" role="Pre">0.5</InitialCharge>
        <Attractor     mapsFromContract="CTRCT_Diffusion" role="Post">
          amplified |Vω|² ≥ 1 − 1/N
        </Attractor>
        <Bound minRef="RAIL_VSS" maxRef="RAIL_VDD"/>
      </State>

    </Group>

    <Group id="BraidPhase" dimension="1">
      <State id="Theta" domain="angle" unit="rad">
        <Bound min="-3.14159265359" max="3.14159265359"
               mapsFromContract="CTRCT_Braid" role="Pre"/>
      </State>
    </Group>

    <Group id="BraidOutputs" dimension="2">
      <State id="Sin_O" domain="voltage" unit="V">
        <Attractor mapsFromContract="CTRCT_Braid" role="Post">φ-weighted sin</Attractor>
        <Bound minRef="RAIL_VSS" maxRef="RAIL_VDD"/>
      </State>
      <State id="Cos_O" domain="voltage" unit="V">
        <Attractor mapsFromContract="CTRCT_Braid" role="Post">φ-weighted cos</Attractor>
        <Bound minRef="RAIL_VSS" maxRef="RAIL_VDD"/>
      </State>
    </Group>

  </StateVariables>

  <!-- ================================================================ -->
  <!-- 5. Algebraic variables  (constraint unknowns)                    -->
  <!-- ================================================================ -->
  <AlgebraicVariables>

    <Algebraic id="Vbar" domain="voltage" unit="V" role="ensemble_mean">
      <Equation>
        Vbar = (V0 + V1 + V2 + V3) / 4.0
      </Equation>
      <DependsOn>V0 V1 V2 V3</DependsOn>
    </Algebraic>

    <Algebraic id="I_NDR_3" domain="current" unit="A" role="oracle_ndr">
      <Equation>
        I_NDR_3 = (1/Rndr) * (-1.5*V3 + 0.5*(V3*V3*V3)/(V0_scale*V0_scale))
      </Equation>
      <DependsOn>V3 Rndr V0_scale</DependsOn>
      <ContractRef>CTRCT_Oracle</ContractRef>
    </Algebraic>

  </AlgebraicVariables>

  <!-- ================================================================ -->
  <!-- 6. Dynamics  (typed edges of the DAE graph)                      -->
  <!-- ================================================================ -->
  <Dynamics>

    <!-- 6.1 Capacitive branches  C·ddt(V) -->
    <Section id="Capacitive" kind="ddt">
      <Edge id="e_ddt0" from="V0" to="V0" paramRef="Cnode">
        <Term>Cnode * ddt(V0)</Term>
      </Edge>
      <Edge id="e_ddt1" from="V1" to="V1" paramRef="Cnode">
        <Term>Cnode * ddt(V1)</Term>
      </Edge>
      <Edge id="e_ddt2" from="V2" to="V2" paramRef="Cnode">
        <Term>Cnode * ddt(V2)</Term>
      </Edge>
      <Edge id="e_ddt3" from="V3" to="V3" paramRef="Cnode">
        <Term>Cnode * ddt(V3)</Term>
      </Edge>
    </Section>

    <!-- 6.2 Inductive branches  idt(-V/L) -->
    <Section id="Inductive" kind="idt">
      <Edge id="e_idt0" from="V0" to="V0" paramRef="Lnode">
        <Term>idt(-V0 / Lnode)</Term>
      </Edge>
      <Edge id="e_idt1" from="V1" to="V1" paramRef="Lnode">
        <Term>idt(-V1 / Lnode)</Term>
      </Edge>
      <Edge id="e_idt2" from="V2" to="V2" paramRef="Lnode">
        <Term>idt(-V2 / Lnode)</Term>
      </Edge>
      <Edge id="e_idt3" from="V3" to="V3" paramRef="Lnode">
        <Term>idt(-V3 / Lnode)</Term>
      </Edge>
    </Section>

    <!-- 6.3 Mean-bus KCL star -->
    <Section id="MeanBus" kind="kcl">
      <Edge id="e_mean0" from="V0"   to="Vbar"/>
      <Edge id="e_mean1" from="V1"   to="Vbar"/>
      <Edge id="e_mean2" from="V2"   to="Vbar"/>
      <Edge id="e_mean3" from="V3"   to="Vbar"/>
    </Section>

    <!-- 6.4 Oracle NDR injection -->
    <Section id="OracleNDR" kind="kcl" contractRef="CTRCT_Oracle">
      <Edge id="e_ndr" from="I_NDR_3" to="V3">
        <Term>cubic NDR phase inversion on target</Term>
      </Edge>
    </Section>

    <!-- 6.5 Diffusion reflection maps -->
    <Section id="DiffusionMap" kind="map" contractRef="CTRCT_Diffusion">
      <Edge id="e_diff0" from="Vbar" to="V0">
        <Term>V0 := 2*Vbar - V0</Term>
      </Edge>
      <Edge id="e_diff1" from="Vbar" to="V1">
        <Term>V1 := 2*Vbar - V1</Term>
      </Edge>
      <Edge id="e_diff2" from="Vbar" to="V2">
        <Term>V2 := 2*Vbar - V2</Term>
      </Edge>
      <Edge id="e_diff3" from="Vbar" to="V3">
        <Term>V3 := 2*Vbar - V3</Term>
      </Edge>
    </Section>

    <!-- 6.6 Braid trigonometric maps -->
    <Section id="BraidMap" kind="map" contractRef="CTRCT_Braid">
      <Edge id="e_braid_sin" from="Theta" to="Sin_O" paramRef="PHI_HALF">
        <Term>Sin_O := PHI_HALF*sin(Theta) + 0.5*cos(Theta)</Term>
      </Edge>
      <Edge id="e_braid_cos" from="Theta" to="Cos_O" paramRef="PHI_HALF">
        <Term>Cos_O := 0.5*sin(Theta) - PHI_HALF*cos(Theta)</Term>
      </Edge>
    </Section>

    <!-- 6.7 Hard clamps (assertion failure → physical rail) -->
    <Section id="Clamps" kind="clamp">
      <Edge id="e_clamp_hi0" from="RAIL_VDD" to="V0"   direction="upper"/>
      <Edge id="e_clamp_lo0" from="RAIL_VSS" to="V0"   direction="lower"/>
      <Edge id="e_clamp_hi1" from="RAIL_VDD" to="V1"   direction="upper"/>
      <Edge id="e_clamp_lo1" from="RAIL_VSS" to="V1"   direction="lower"/>
      <Edge id="e_clamp_hi2" from="RAIL_VDD" to="V2"   direction="upper"/>
      <Edge id="e_clamp_lo2" from="RAIL_VSS" to="V2"   direction="lower"/>
      <Edge id="e_clamp_hi3" from="RAIL_VDD" to="V3"   direction="upper"/>
      <Edge id="e_clamp_lo3" from="RAIL_VSS" to="V3"   direction="lower"/>
      <Edge id="e_clamp_sin" from="RAIL_VDD" to="Sin_O" direction="upper"/>
      <Edge id="e_clamp_cos" from="RAIL_VDD" to="Cos_O" direction="upper"/>
      <Edge id="e_clamp_sin_lo" from="RAIL_VSS" to="Sin_O" direction="lower"/>
      <Edge id="e_clamp_cos_lo" from="RAIL_VSS" to="Cos_O" direction="lower"/>
    </Section>

  </Dynamics>

  <!-- ================================================================ -->
  <!-- 7. Cross-domain mapping table                                    -->
  <!-- ================================================================ -->
  <CrossDomainMappings>
    <Mapping id="m_bound">
      <SPARK>Bounded Integer Range (0 ≤ v ≤ N)</SPARK>
      <VerilogA>Voltage Rails (0 V to V_dd)</VerilogA>
      <Transistor>Supply clamping and saturation limits</Transistor>
      <GraphRef>Rails / Bound elements</GraphRef>
    </Mapping>
    <Mapping id="m_invariant">
      <SPARK>State Invariant (Post(S, S'))</SPARK>
      <VerilogA>Steady-state nodal balance (dV/dt = 0)</VerilogA>
      <Transistor>Equilibrium collector/drain current balance</Transistor>
      <GraphRef>Attractor elements / DiffusionMap section</GraphRef>
    </Mapping>
    <Mapping id="m_matrix">
      <SPARK>Matrix Multiplier (ρ(σ_k))</SPARK>
      <VerilogA>Linear VCVS</VerilogA>
      <Transistor>Gilbert cell / Translinear multiplier core</Transistor>
      <GraphRef>BraidMap section</GraphRef>
    </Mapping>
    <Mapping id="m_hash">
      <SPARK>FNV-1a / Hash Integrity</SPARK>
      <VerilogA>Non-linear mixing stage</VerilogA>
      <Transistor>Cross-coupled mixer core with exponential response</Transistor>
      <GraphRef>OracleNDR section (cubic non-linearity)</GraphRef>
    </Mapping>
  </CrossDomainMappings>

  <!-- ================================================================ -->
  <!-- 8. Semiconductor bounds                                          -->
  <!-- ================================================================ -->
  <SemiconductorBounds>
    <Bound id="ThermalVoltage" paramRef="V_T">
      <Symbol>V_T = kT/q</Symbol>
      <Value unit="mV">25.85</Value>
      <Constraint>Translinear loops require temperature-compensated bias</Constraint>
    </Bound>
    <Bound id="InversionRegion">
      <Constraint>MOSFET/BJT remain in designated weak/strong inversion to avoid harmonic distortion of algebraic projections</Constraint>
    </Bound>
    <Bound id="PowerDelayProduct">
      <Constraint>Execution latency bounded by transistor transit frequency f_T</Constraint>
    </Bound>
    <Bound id="MobilityDegradation">
      <Constraint>High-frequency braiding limited by carrier velocity saturation in FinFET channels; g_m degrades at high E-field</Constraint>
    </Bound>
    <Bound id="SubthresholdLeakage">
      <Constraint>Isolation switches operate in strong inversion or deep subthreshold to protect continuous-time charge packets</Constraint>
    </Bound>
  </SemiconductorBounds>

</DAEInvertedGraph>
